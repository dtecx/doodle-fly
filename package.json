{
  "name": "doodle-fly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A fruit fly's whole brain (FlyWire v783 connectome, 138,639 LIF neurons) plays a Doodle-Jump-style game in the browser.",
  "license": "MIT",
  "author": "dtecx",
  "keywords": [
    "connectome",
    "flywire",
    "drosophila",
    "fruit-fly",
    "spiking-neural-network",
    "leaky-integrate-and-fire",
    "neuroscience",
    "threejs",
    "game"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data": "uv run scripts/build_data.py",
    "play": "node scripts/play.ts",
    "probe": "node scripts/probe.ts",
    "survey": "node scripts/survey.ts",
    "readout": "node scripts/readout.ts",
    "capture": "node scripts/capture.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
